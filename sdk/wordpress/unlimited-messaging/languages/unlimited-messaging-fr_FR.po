#: includes/class-settings.php:86
msgid ""
"New order #{order_number} on {site_name}: {order_total} from "
"{customer_full_name} ({order_items}). {admin_order_url}"
msgstr ""
"Nouvelle commande n°{order_number} sur {site_name} : {order_total} de "
"{customer_full_name} ({order_items}). {admin_order_url}"

#: includes/class-settings.php:87
msgid ""
"Hi {customer_first_name}, thank you for your order #{order_number} on "
"{site_name}! We are preparing it. Total: {order_total}. Details: {order_url}"
msgstr ""
"Bonjour {customer_first_name}, merci pour votre commande n°{order_number} "
"sur {site_name} ! Nous la préparons. Total : {order_total}. Détails : "
"{order_url}"

#: includes/class-settings.php:88
msgid ""
"Hi {customer_first_name}, we received your order #{order_number} on "
"{site_name}. It will be prepared as soon as your payment is confirmed. "
"Details: {order_url}"
msgstr ""
"Bonjour {customer_first_name}, nous avons bien reçu votre commande "
"n°{order_number} sur {site_name}. Elle sera préparée dès que votre paiement "
"sera confirmé. Détails : {order_url}"

#: includes/class-settings.php:89
msgid ""
"Good news {customer_first_name}: your order #{order_number} from {site_name}"
" is on its way! Details: {order_url}"
msgstr ""
"Bonne nouvelle {customer_first_name} : votre commande n°{order_number} de "
"{site_name} est en route ! Détails : {order_url}"

#: includes/class-settings.php:90
msgid ""
"Hi {customer_first_name}, your order #{order_number} on {site_name} has been"
" cancelled. Reply to this message if you have any question."
msgstr ""
"Bonjour {customer_first_name}, votre commande n°{order_number} sur "
"{site_name} a été annulée. Répondez à ce message pour toute question."

#: includes/class-settings.php:91
msgid ""
"Order #{order_number} ({order_total}) from {customer_full_name} was "
"cancelled. {admin_order_url}"
msgstr ""
"La commande n°{order_number} ({order_total}) de {customer_full_name} a été "
"annulée. {admin_order_url}"

#: includes/class-settings.php:92
msgid ""
"Hi {customer_first_name}, your order #{order_number} on {site_name} has been"
" refunded. The money should reach your account within a few days."
msgstr ""
"Bonjour {customer_first_name}, votre commande n°{order_number} sur "
"{site_name} a été remboursée. L'argent devrait arriver sur votre compte "
"d'ici quelques jours."

#: includes/class-settings.php:93
msgid ""
"Hi {customer_first_name}, the payment for your order #{order_number} on "
"{site_name} did not go through. You can try again here: {payment_url}"
msgstr ""
"Bonjour {customer_first_name}, le paiement de votre commande "
"n°{order_number} sur {site_name} n'est pas passé. Vous pouvez réessayer ici "
": {payment_url}"

#: includes/class-settings.php:94
msgid ""
"Payment failed for order #{order_number} ({order_total}) from "
"{customer_full_name}. {admin_order_url}"
msgstr ""
"Paiement échoué pour la commande n°{order_number} ({order_total}) de "
"{customer_full_name}. {admin_order_url}"

#: includes/class-settings.php:95
msgid ""
"Hi {customer_first_name}, a note about your order #{order_number}: "
"{customer_note}"
msgstr ""
"Bonjour {customer_first_name}, une note sur votre commande n°{order_number} "
": {customer_note}"

#: includes/class-settings.php:107
msgid "{site_name}: order #{order_number}"
msgstr "{site_name} : commande n°{order_number}"

#: includes/class-settings.php:116
